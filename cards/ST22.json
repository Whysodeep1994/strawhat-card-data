  {
    "id": "ST22-015",
    "name": "I Am Whitebeard!!",
    "category": "event",
    "colors": ["blue"],
    "cost": 8,
    "types": ["The Four Emperors", "Whitebeard Pirates"],
    "rarity": "C",
    "blockIcon": 3,
    "text": "[Main] If your Leader's type includes \"Whitebeard Pirates\", play up to 1 [Edward.Newgate] from your hand. Then, you may add 1 card from the top or bottom of your Life cards to your hand. If you do, up to 1 of your Leader gains +2000 power until the end of your opponent's next turn.",
    "image": "images/ST22-015.png",
    "source": "https://en.onepiece-cardgame.com/cardlist/?series=569022",
    "effects": [
      {
        "timing": "main",
        "steps": [
          {
            "do": "if",
            "conditions": [
              {
                "leaderTypeIncludes": "Whitebeard Pirates"
              }
            ],
            "steps": [
              {
                "do": "playFromHand",
                "filter": {
                  "name": "Edward.Newgate"
                }
              }
            ]
          },
          {
            "do": "if",
            "conditions": [
              {
                "lifeAtLeast": 1
              }
            ],
            "steps": [
              {
                "do": "chooseOne",
                "options": [
                  {
                    "label": "Add the top Life card to your hand and give your Leader +2000 power",
                    "steps": [
                      {
                        "do": "lifeToHand",
                        "count": 1
                      },
                      {
                        "do": "powerUp",
                        "target": {
                          "side": "self",
                          "zone": "leader",
                          "upTo": true
                        },
                        "amount": 2000,
                        "duration": "opponentsNextTurn"
                      }
                    ]
                  },
                  {
                    "label": "Add the bottom Life card to your hand and give your Leader +2000 power",
                    "steps": [
                      {
                        "do": "lifeToHand",
                        "count": 1,
                        "fromBottom": true
                      },
                      {
                        "do": "powerUp",
                        "target": {
                          "side": "self",
                          "zone": "leader",
                          "upTo": true
                        },
                        "amount": 2000,
                        "duration": "opponentsNextTurn"
                      }
                    ]
                  },
                  {
                    "label": "Don't add a Life card",
                    "steps": []
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "notes": "\"You may add 1 card from the top or bottom of your Life cards ... If you do\" is a choice of top, bottom, or neither."
  },
