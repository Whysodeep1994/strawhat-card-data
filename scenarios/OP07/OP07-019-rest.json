    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.1"]
    }
  ],
  "expect": {
    "p1.donRested": 1,
    "p2.characters.1.rested": true
  }
