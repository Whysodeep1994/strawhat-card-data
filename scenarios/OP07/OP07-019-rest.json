{
  "name": "Jewelry Bonney (Leader) rests 1 DON!! to rest an opponent's Character when they attack",
  "rules": ["10-2-16", "10-2-13"],
  "setup": {
    "turn": 4,
    "turnPlayer": "p2",
    "p1": {
      "leader": "OP07-019",
      "don": {
        "active": 1
      }
    },
    "p2": {
      "characters": ["TEST-C5-5000", "TEST-FILLER"]
    }
  },
  "actions": [
    {
      "type": "attack",
      "player": "p2",
      "attacker": "p2.characters.0",
      "target": "p1.leader"
