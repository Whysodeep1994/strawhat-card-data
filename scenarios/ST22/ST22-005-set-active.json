{
  "name": "Oden rests 3 DON!! and returns another Character to set itself active",
  "rules": ["8-3-1"],
  "setup": {
    "p1": {
      "characters": [
        {
          "card": "ST22-005",
          "rested": true
        },
        "TEST-FILLER"
      ],
      "don": {
        "active": 3
      }
    }
  },
  "actions": [
    {
      "type": "activate",
