{
  "name": "Doflamingo keeps 3 rested cards rested through the next Refresh Phase",
  "rules": ["10-2-6"],
  "setup": {
    "p1": {
      "hand": ["OP04-031"],
      "don": {
        "active": 10
      }
    },
    "p2": {
      "leader": {
        "card": "TEST-LEADER",
        "rested": true
      },
      "characters": [
        {
          "card": "TEST-FILLER",
          "rested": true
        },
        {
          "card": "TEST-FILLER",
          "rested": true
        }
      ]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.leader", "p2.characters.0", "p2.characters.1"]
    },
    {
      "type": "endTurn",
      "player": "p1"
    }
  ],
  "expect": {
    "p2.leader.rested": true,
    "p2.characters.0.rested": true,
    "p2.characters.1.rested": true
  }
}
