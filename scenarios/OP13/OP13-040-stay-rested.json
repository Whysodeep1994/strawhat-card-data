{
  "name": "I Know You're Strong... keeps 2 rested Characters rested in the next Refresh Phase",
  "rules": ["10-2-3"],
  "setup": {
    "p1": {
      "hand": ["OP13-040"],
      "don": {
        "active": 3
      }
    },
    "p2": {
      "characters": [
        {
          "card": "TEST-C4-4000",
          "rested": true
        },
        {
          "card": "TEST-C5-5000",
          "rested": true
        }
      ]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0", "p2.characters.1"]
    },
    {
      "type": "endTurn",
      "player": "p1"
    }
  ],
  "expect": {
    "p2.characters.0.rested": true,
    "p2.characters.1.rested": true
  }
}
