{
  "name": "Crocodile keeps a rested Character from becoming active",
  "rules": ["6-2-3"],
  "setup": {
    "p1": {
      "hand": ["ST30-010"],
      "don": {
        "active": 6
      }
    },
    "p2": {
      "characters": [
        {
          "card": "TEST-C5-5000",
          "rested": true
        }
      ]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0"]
    },
    {
      "type": "endTurn",
      "player": "p1"
    }
  ],
  "expect": {
    "p2.characters.0.rested": true
  }
}
