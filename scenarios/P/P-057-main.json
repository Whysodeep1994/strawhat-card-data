{
  "name": "Fleeting Lullaby keeps rested Characters rested through the next Refresh Phase",
  "rules": ["6-2-3", "10-2-3"],
  "setup": {
    "p1": {
      "leader": "ST11-001",
      "hand": ["P-057"],
      "don": {
        "active": 3
      }
    },
    "p2": {
      "characters": [
        {
          "card": "TEST-FILLER",
          "rested": true
        },
        {
          "card": "TEST-C5-5000",
          "rested": true
        }
      ]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.1"],
      "illegal": true
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0"]
    },
    {
      "type": "endTurn",
      "player": "p1"
    }
  ],
  "expect": {
    "p2.characters.0.rested": true,
    "p2.characters.1.rested": false
  }
}
