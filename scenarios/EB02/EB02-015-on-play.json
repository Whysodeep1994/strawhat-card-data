{
  "name": "Jewelry Bonney keeps a rested Character rested and sets a DON!! active at the end of the turn",
  "rules": ["10-2-6"],
  "setup": {
    "p1": {
      "hand": ["EB02-015"],
      "don": {
        "active": 7
      }
    },
    "p2": {
      "characters": [
        {
          "card": "TEST-FILLER",
          "rested": true
        }
      ]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0"]
    },
    {
      "type": "endTurn",
      "player": "p1"
    }
  ],
  "expect": {
    "p1.donActive": 1,
    "p2.characters.0.rested": true
  }
}
