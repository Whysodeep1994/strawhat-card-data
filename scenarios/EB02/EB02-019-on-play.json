{
  "name": "Roronoa Zoro rests a Character and can attack Characters when played",
  "rules": ["10-2-6", "10-1-6"],
  "setup": {
    "p1": {
      "leader": "EB02-010",
      "hand": ["EB02-019"],
      "don": {
        "active": 4
      }
    },
    "p2": {
      "characters": ["TEST-C4-4000", "TEST-FILLER"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0"]
    },
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.characters.0",
      "target": "p2.characters.0"
    },
    {
      "type": "pass",
      "player": "p2"
    }
  ],
  "expect": {
    "p2.characters": 1
  }
}
