{
  "name": "Yosaku keeps a rested cost 4 Character from becoming active",
  "rules": ["10-2-1"],
  "setup": {
    "p1": {
      "characters": ["OP14-035"]
    },
    "p2": {
      "characters": [
        {
          "card": "TEST-C4-4000",
