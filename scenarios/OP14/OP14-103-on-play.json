{
  "name": "Gloriosa takes a Life card to put a card from hand on top of Life",
  "rules": ["10-2-1"],
  "setup": {
    "p1": {
      "hand": ["OP14-103", "TEST-FILLER"],
      "don": {
        "active": 2
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": false
