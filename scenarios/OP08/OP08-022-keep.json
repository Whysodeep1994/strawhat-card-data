{
  "name": "Inuarashi keeps 2 rested Characters rested",
  "rules": ["6-2-4"],
  "setup": {
    "p1": {
      "leader": "OP08-021",
      "hand": ["OP08-022"],
      "don": {
        "active": 5
      }
    },
    "p2": {
      "characters": [
        {
          "card": "TEST-FILLER",
          "rested": true
        },
        {
          "card": "TEST-C4-4000",
          "rested": true
        }
      ]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0", "p2.characters.1"]
    },
    {
      "type": "endTurn",
      "player": "p1"
    }
  ],
  "expect": {
    "p2.characters.0.rested": true,
    "p2.characters.1.rested": true
  }
}
