{
  "name": "Carrot when attacking keeps a rested Character rested",
  "rules": ["6-2-4"],
  "setup": {
    "p1": {
      "characters": ["OP08-023"]
    },
    "p2": {
      "characters": [
        {
          "card": "TEST-FILLER",
          "rested": true
        }
      ]
    }
  },
  "actions": [
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.characters.0",
      "target": "p2.leader"
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0"]
    },
    {
      "type": "pass",
      "player": "p2"
    },
    {
      "type": "endTurn",
      "player": "p1"
    }
  ],
  "expect": {
    "p2.characters.0.rested": true
  }
}
