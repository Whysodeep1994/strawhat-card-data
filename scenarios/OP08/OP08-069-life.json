{
  "name": "Charlotte Linlin adds a Life card and puts an opponent's Character into their Life",
  "rules": ["8-3-1"],
  "setup": {
    "p1": {
      "hand": ["OP08-069", "TEST-FILLER"],
      "don": {
        "active": 10
      }
    },
    "p2": {
      "characters": ["TEST-C6-6000"]
    }
  },
  "actions": [
    {
      "type": "playCard",
