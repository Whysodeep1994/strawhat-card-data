{
  "name": "Garchu rests a Minks Character to rest an opponent's Character",
  "rules": ["8-3-1"],
  "setup": {
    "p1": {
      "hand": ["OP08-037"],
      "don": {
        "active": 1
      },
      "characters": ["OP08-027"]
    },
    "p2": {
      "characters": ["TEST-FILLER"]
    }
  },
  "actions": [
    {
