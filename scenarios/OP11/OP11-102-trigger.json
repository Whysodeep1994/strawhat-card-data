{
  "name": "Camie trashes a Life card from each player when the opponent activates a [Trigger]",
  "rules": ["8-1-3-1"],
  "setup": {
    "p1": {
      "characters": ["OP11-102"]
    },
    "p2": {
      "life": ["OP11-037", "TEST-FILLER", "TEST-FILLER", "TEST-FILLER"]
    }
  },
  "actions": [
    {
      "type": "attack",
      "player": "p1",
      "attacker": "p1.leader",
      "target": "p2.leader"
    },
    {
      "type": "pass",
      "player": "p2"
    },
    {
      "type": "confirm",
      "player": "p2",
      "accept": true
    }
  ],
  "expect": {
    "p1.life": 3,
    "p2.life": 2
  }
}
