{
  "name": "Crocodile & Mihawk: trash 1 card instead of losing a {Cross Guild} Character to the opponent",
  "rules": ["8-1-3-4"],
  "setup": {
    "turn": 4,
    "turnPlayer": "p2",
    "p1": {
      "characters": ["ST25-003", "OP09-055"],
      "hand": ["TEST-FILLER"]
    },
    "p2": {
      "hand": ["TEST-KO-EVENT"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p2",
      "card": "p2.hand.0"
    },
    {
      "type": "choose",
      "player": "p2",
      "cards": ["p1.characters.1"]
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    }
  ],
  "expect": {
    "p1.characters": 2,
    "p1.hand": 0,
    "p1.trash": 1
  }
}
