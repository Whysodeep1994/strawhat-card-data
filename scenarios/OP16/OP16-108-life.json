{
  "name": "Shiryu trashes a card to add a {Blackbeard Pirates} card from the trash to Life face-up",
  "rules": ["10-2-2"],
  "setup": {
    "p1": {
      "hand": ["OP16-108", "TEST-FILLER"],
      "trash": ["OP16-110"],
      "don": {
        "active": 6
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p1.trash.1"]
    }
  ],
  "expect": {
    "p1.life": 5,
    "p1.life.0.faceUp": true
  }
}
