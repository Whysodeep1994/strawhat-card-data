{
  "name": "Shirahoshi turns a Life card face-up instead of a Character leaving",
  "rules": ["8-1-3-4"],
  "setup": {
    "turn": 4,
    "turnPlayer": "p2",
    "p1": {
      "characters": ["OP12-102", "TEST-C5-5000"]
    },
    "p2": {
      "hand": ["TEST-KO-EVENT"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p2",
      "card": "p2.hand.0"
    },
    {
      "type": "choose",
      "player": "p2",
      "cards": ["p1.characters.1"]
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    }
  ],
  "expect": {
    "p1.characters": 2,
    "p1.life.0.faceUp": true
  }
}
