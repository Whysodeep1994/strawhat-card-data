{
  "name": "Demon Aura rests 3 DON!! to rest 2 of the opponent's Characters",
  "rules": ["10-2-3"],
  "setup": {
    "p1": {
      "hand": ["OP12-037"],
      "don": {
        "active": 4
      }
    },
    "p2": {
      "characters": ["TEST-C4-4000", "TEST-C5-5000"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "chooseOne",
      "player": "p1",
      "option": 0
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.characters.0", "p2.characters.1"]
    }
  ],
  "expect": {
    "p2.characters.0.rested": true,
    "p2.characters.1.rested": true
  }
}
