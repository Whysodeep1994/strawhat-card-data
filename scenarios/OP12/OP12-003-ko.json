{
  "name": "Crocus reveals 2 Events when K.O.'d to play a red 3000 power Character",
  "rules": ["8-1-3-4"],
  "setup": {
    "turn": 4,
    "turnPlayer": "p2",
    "p1": {
      "characters": ["OP12-003"],
      "hand": ["TEST-KO-EVENT", "TEST-BOUNCE-EVENT", "TEST-FILLER"]
    },
    "p2": {
      "hand": ["TEST-KO-EVENT"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p2",
      "card": "p2.hand.0"
    },
    {
      "type": "choose",
      "player": "p2",
      "cards": ["p1.characters.0"]
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p1.hand.2"]
    }
  ],
  "expect": {
    "p1.characters": 1,
    "p1.characters.0.cardId": "TEST-FILLER"
  }
}
