{
  "name": "Donquixote Rosinante rests and trashes a card instead of a blue {Navy} Character leaving",
  "rules": ["8-1-3-4"],
  "setup": {
    "turn": 4,
    "turnPlayer": "p2",
    "p1": {
      "characters": ["OP12-048", "OP12-045"],
      "hand": ["TEST-FILLER"]
    },
    "p2": {
      "hand": ["TEST-KO-EVENT"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p2",
      "card": "p2.hand.0"
    },
    {
      "type": "choose",
      "player": "p2",
      "cards": ["p1.characters.1"]
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    }
  ],
  "expect": {
    "p1.characters": 2,
    "p1.characters.0.rested": true,
    "p1.trash": 1
  }
}
