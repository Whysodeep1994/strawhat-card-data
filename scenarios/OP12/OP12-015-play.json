{
  "name": "Monkey.D.Luffy reveals 2 Events to play a red Character, then gives a rested DON!!",
  "rules": ["10-2-6"],
  "setup": {
    "p1": {
      "hand": ["OP12-015", "TEST-KO-EVENT", "TEST-BOUNCE-EVENT", "TEST-FILLER"],
      "don": {
        "active": 4,
        "rested": 1
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p1.hand.2"]
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p1.leader"]
    }
  ],
  "expect": {
    "p1.characters": 2,
    "p1.leader.givenDon": 1
  }
}
