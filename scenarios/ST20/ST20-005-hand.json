{
  "name": "Charlotte Linlin: the opponent chooses to trash 2 cards from hand",
  "rules": ["10-2-6"],
  "setup": {
    "p1": {
      "hand": ["ST20-005", "TEST-FILLER"],
      "don": {
        "active": 6
      }
    },
    "p2": {
      "hand": ["TEST-FILLER", "TEST-FILLER", "TEST-FILLER"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "chooseOne",
      "player": "p2",
      "option": 0
    },
    {
      "type": "choose",
      "player": "p2",
      "cards": ["p2.hand.0", "p2.hand.1"]
    }
  ],
  "expect": {
    "p2.life": 4,
    "p2.hand": 1,
    "p2.trash": 2
  }
}
