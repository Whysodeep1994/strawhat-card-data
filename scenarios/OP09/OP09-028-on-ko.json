{
  "name": "Sanji takes a Life card when K.O.'d to play an {ODYSSEY} Character from the trash rested",
  "rules": ["8-1-3-1"],
  "setup": {
    "turn": 4,
    "turnPlayer": "p2",
    "p1": {
      "characters": ["OP09-028"],
      "trash": ["OP09-038"]
    },
    "p2": {
      "hand": ["TEST-KO-EVENT"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p2",
      "card": "p2.hand.0"
    },
    {
      "type": "choose",
      "player": "p2",
      "cards": ["p1.characters.0"]
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": false
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p1.trash.1"]
    }
  ],
  "expect": {
    "p1.characters": 1,
    "p1.characters.0.cardId": "OP09-038",
    "p1.characters.0.rested": true,
    "p1.hand": 1,
    "p1.life": 3
  }
}
