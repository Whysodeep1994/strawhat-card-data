{
  "name": "Nami returns 1 DON!! and gives up to 2 rested DON!! to the Leader",
  "rules": ["8-3-1-6", "6-5-5"],
  "setup": {
    "p1": {
      "hand": ["OP09-070"],
      "don": {
        "active": 3,
        "rested": 2
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "chooseOne",
      "player": "p1",
      "option": 0
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p1.leader"]
    }
  ],
  "expect": {
    "p1.leader.givenDon": 2,
    "p1.donRested": 2,
    "p1.donDeck": 1
  }
}
