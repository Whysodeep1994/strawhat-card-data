{
  "name": "Kuro rests 2 East Blue Characters to set himself active and rest a Character",
  "rules": ["10-2-2"],
  "setup": {
    "p1": {
      "leader": {
        "card": "OP03-021",
        "rested": true
      },
      "characters": ["OP03-023", "OP03-035"],
      "don": {
        "active": 3
      }
