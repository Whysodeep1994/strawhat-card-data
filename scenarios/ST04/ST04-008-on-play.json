{
  "name": "Jack trashes a card to add an active DON!!",
  "rules": ["10-2-6"],
  "setup": {
    "p1": {
      "hand": ["ST04-008", "TEST-FILLER"],
      "don": {
        "active": 3,
        "deck": 2
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
