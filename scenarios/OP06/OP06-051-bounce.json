{
  "name": "Tsuru makes the opponent return 1 of their Characters",
  "rules": ["10-2-6"],
  "setup": {
    "p1": {
      "hand": ["OP06-051", "TEST-FILLER", "TEST-FILLER"],
      "don": {
        "active": 5
      }
    },
    "p2": {
      "characters": ["TEST-FILLER", "TEST-C4-4000"]
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
    },
    {
      "type": "confirm",
      "player": "p1",
      "accept": true
    },
    {
      "type": "choose",
      "player": "p2",
      "cards": ["p2.characters.1"]
    }
  ],
  "expect": {
    "p1.trash": 2,
    "p2.characters": 1,
    "p2.hand": 1,
    "p2.hand.0.cardId": "TEST-C4-4000"
  }
}
