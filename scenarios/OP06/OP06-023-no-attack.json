{
  "name": "Arlong stops the opponent's rested Leader from attacking",
  "rules": ["10-2-6"],
  "setup": {
    "p1": {
      "hand": ["OP06-023", "TEST-FILLER"],
      "don": {
        "active": 4
      }
    },
    "p2": {
      "leader": {
        "card": "TEST-LEADER",
        "rested": true
      }
    }
  },
  "actions": [
    {
      "type": "playCard",
      "player": "p1",
      "card": "p1.hand.0"
