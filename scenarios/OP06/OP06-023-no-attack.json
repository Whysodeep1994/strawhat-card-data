      "player": "p1",
      "accept": true
    },
    {
      "type": "choose",
      "player": "p1",
      "cards": ["p2.leader"]
    }
  ],
  "expect": {
    "p1.trash": 1,
    "modifiers.0.status": "cannotAttack"
  }
}
